{
  "name": "reel-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "prune": "node server/prune.js",
    "hub": "node --no-warnings server/hub.js --deploy",
    "deploy:studio": "node --no-warnings server/studio-site.js",
    "deploy:all": "npm run prune && npm run hub && npm run deploy:studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@tanstack/react-query": "^5.108.1",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "lucide-react": "^1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
